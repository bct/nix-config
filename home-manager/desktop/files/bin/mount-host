#!/bin/sh

set -euo pipefail

HOST="$1"
HOST_SHORT="${HOST%%.*}"

declare -rA HOST_ALIAS=(
  ["booklore"]="medley"
)

declare -rA REMOTE_DIR_BY_HOST_SHORT=(
  ["booklore"]="/var/lib/booklore/bookdrop"
  ["fever-dreams"]="/userdata"
  ["paperless"]="/var/lib/paperless/consume"
)

REMOTE_DIR="${REMOTE_DIR_BY_HOST_SHORT[$HOST_SHORT]:-}"
TARGET_DIR="$HOME/mnt/$HOST_SHORT"

HOST="${HOST_ALIAS[$HOST_SHORT]:-$HOST}"

mkdir -p $TARGET_DIR
sshfs $HOST:$REMOTE_DIR $TARGET_DIR -o reconnect,ServerAliveInterval=30
